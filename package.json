{
  "name": "beyonders-wetland",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "next build --webpack",
    "prestart": "node scripts/check-node-version.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "node --no-warnings=ExperimentalWarning --loader ./tests/strip-loader.mjs --test src/lib/*.test.ts",
    "start:public": "BEYONDERS_MODE=public next start"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}